{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "expertsystemsau/trackto-php-sdk",
    "description": "track.to PHP SDK monorepo: framework-agnostic client and Laravel integration.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "symfony/process": "^7.2||^8.0",
        "symfony/yaml": "^7.2||^8.0"
    },
    "conflict": {
        "brianium/paratest": "7.26.1"
    },
    "autoload": {
        "psr-4": {
            "ExpertSystems\\TrackTo\\": "packages/trackto-client/src/",
            "ExpertSystems\\TrackTo\\Laravel\\": "packages/trackto-laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExpertSystems\\TrackTo\\Tests\\": "packages/trackto-client/tests/",
            "ExpertSystems\\TrackTo\\Laravel\\Tests\\": "packages/trackto-laravel/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "check:deps": [
            "@php bin/check-package-deps"
        ],
        "check:archive": [
            "@php bin/check-package-archive"
        ],
        "scan:secrets": [
            "sh bin/scan-secrets"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit",
            "@check:deps",
            "@check:archive",
            "@scan:secrets"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExpertSystems\\TrackTo\\Laravel\\TrackToServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
