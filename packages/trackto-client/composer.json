{
    "name": "expertsystemsau/trackto-php-client",
    "description": "Framework-agnostic PHP client for the track.to API",
    "keywords": [
        "ExpertSystems",
        "trackto",
        "url-shortener",
        "api-client"
    ],
    "homepage": "https://github.com/expertsystemsau/trackto-php-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Mitchell Williams",
            "email": "mitchell@expertsystems.com.au",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.6||^5.0"
    },
    "autoload": {
        "psr-4": {
            "ExpertSystems\\TrackTo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExpertSystems\\TrackTo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
